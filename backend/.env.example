# ============================================
# REQUIRED - Application Core Configuration
# ============================================

# Environment mode (development, production, staging)
NODE_ENV=development

# Backend server port (change if already in use)
PORT=5000

# MongoDB Connection URI
# LOCAL DEV: mongodb://127.0.0.1:27017/museum
# MONGODB ATLAS: mongodb+srv://username:password@cluster.mongodb.net/museum?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/museum?retryWrites=true&w=majority

# JWT Configuration
# SECRET: Use a strong random string (min 32 characters) - CHANGE IN PRODUCTION!
# Example: JwtSecretKey@2024MuseumTourABC123XYZ!
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# How long JWT access tokens are valid (15m = 15 minutes)
JWT_ACCESS_EXPIRES_IN=15m

# Comma-separated whitelist of allowed request origins (authoritative).
# Development: include all localhost ports your frontend may use.
# Production:  include only your live domain(s); remove all localhost entries.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://museumtour.com

# Legacy single-origin fallback — kept for backward-compatibility only.
# ALLOWED_ORIGINS takes precedence; this value is only read when ALLOWED_ORIGINS is absent.
CORS_ORIGIN=http://localhost:5173

# ============================================
# OPTIONAL - Logging & Monitoring
# ============================================

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Sentry DSN for error tracking (leave empty to disable)
# Get from: https://sentry.io/
SENTRY_DSN=

# Elasticsearch URL for centralized logging (optional)
ELASTICSEARCH_URL=

# ============================================
# OPTIONAL - Caching (Performance)
# ============================================

# Redis cache connection (optional, falls back to in-memory)
# LEAVE EMPTY if Redis is not running — app will use in-memory cache
# Local: redis://localhost:6379
# Heroku: Set via redis addon
# REDIS_URI=redis://localhost:6379

# ============================================
# OPTIONAL - Email Service
# ============================================

# SMTP settings for password reset emails
# Leave empty in development (tokens returned in API response)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sender email address for automated emails
SMTP_FROM=noreply@museumtour.com

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:5173
